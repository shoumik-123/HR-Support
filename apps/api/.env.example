# Postgres (embedded dev DB from `pnpm db:start`, or docker-compose)
DATABASE_URL=postgresql://veyra:veyra@localhost:5433/veyra

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

PORT=4000
WEB_ORIGIN=http://localhost:3000
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# AI - optional. Without a key, parsing and matching use deterministic heuristics.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Email - optional. Without SMTP, emails are printed to the API log.
SMTP_URL=
MAIL_FROM="Veyra Talent <no-reply@veyra.local>"

# WhatsApp (Meta Cloud API) - optional. Without these, WhatsApp messages are recorded in the
# Communications log with their full text and the reason they were not delivered, and the
# feature works everywhere else exactly as if it were connected.
# The last two are only needed for delivery receipts, which require a public URL.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
