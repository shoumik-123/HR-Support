// Veyra Talent - Phase 1 data model.
// Every tenant-owned table carries organizationId and is always queried with it.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Identity & tenancy ─────────────────────────

enum Role {
  OWNER
  ADMIN
  HR_MANAGER
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
  EVALUATOR
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  emailVerifiedAt DateTime?
  isPlatformAdmin Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships Membership[]
  sessions    Session[]
  tokens      UserToken[]

  interviewSlots  InterviewParticipant[]
  scorecards      Scorecard[]
  availability    InterviewerAvailability[]
  offerApprovals  OfferApproval[]
  onboardingTasks OnboardingTask[]
}

model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  logoUrl          String?
  brandColor       String?
  website          String?
  industry         String?
  companySize      String?
  country          String?
  timezone         String   @default("Asia/Dhaka")
  defaultCurrency  String   @default("BDT")
  // Blind mode hides names/contact/photos from reviewers and from AI matching prompts.
  blindModeDefault Boolean  @default(false)
  // Public careers portal: served at /careers/<slug> with no authentication.
  careersEnabled   Boolean  @default(true)
  careersIntro     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships  Membership[]
  invitations  Invitation[]
  departments  Department[]
  jobs         Job[]
  stages       PipelineStage[]
  candidates   Candidate[]
  resumes      Resume[]
  applications Application[]
  matches      MatchResult[]
  notes        Note[]
  activities   Activity[]
  batches      UploadBatch[]
  aiUsage      AiUsage[]

  questions           InterviewQuestion[]
  interviewTemplates  InterviewTemplate[]
  interviews          Interview[]
  scorecards          Scorecard[]
  availability        InterviewerAvailability[]
  emailTemplates      EmailTemplate[]
  emailAutomations    EmailAutomation[]
  communications      Communication[]
  assessmentQuestions AssessmentQuestion[]
  assessmentTemplates AssessmentTemplate[]
  assessments         Assessment[]
  offerTemplates      OfferTemplate[]
  offers              Offer[]
  onboardingTasks     OnboardingTask[]
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ───────────────────────── Jobs ─────────────────────────

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs         Job[]

  @@unique([organizationId, name])
}

model Job {
  id                   String         @id @default(cuid())
  organizationId       String
  title                String
  departmentId         String?
  description          String
  responsibilities     String?
  location             String?
  workMode             WorkMode       @default(ONSITE)
  employmentType       EmploymentType @default(FULL_TIME)
  status               JobStatus      @default(DRAFT)
  requiredSkills       String[]
  preferredSkills      String[]
  minExperienceYears   Int?
  maxExperienceYears   Int?
  educationRequirement String?
  salaryMin            Int?
  salaryMax            Int?
  salaryCurrency       String         @default("BDT")
  salaryVisible        Boolean        @default(false)
  openings             Int            @default(1)
  // Listed on the public careers portal. A published job can still be kept off it.
  publicApply          Boolean        @default(true)
  // Weights used by candidate matching; see MatchingCriteria in matching.criteria.ts.
  matchingCriteria     Json?
  hiringManagerIds     String[]
  expiresAt            DateTime?
  publishedAt          DateTime?
  closedAt             DateTime?
  createdById          String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  applications       Application[]
  matches            MatchResult[]
  batches            UploadBatch[]
  questions          InterviewQuestion[]
  interviewTemplates InterviewTemplate[]
  interviews         Interview[]

  assessmentQuestions AssessmentQuestion[]
  assessmentTemplates AssessmentTemplate[]
  assessments         Assessment[]
  offers              Offer[]

  @@index([organizationId, status])
}

// ───────────────────────── Pipeline ─────────────────────────

enum StageKind {
  APPLIED
  SCREENING
  SHORTLISTED
  ASSESSMENT
  INTERVIEW
  FINAL_REVIEW
  OFFER
  HIRED
  REJECTED
  CUSTOM
}

model PipelineStage {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  kind           StageKind @default(CUSTOM)
  position       Int
  color          String?
  createdAt      DateTime  @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applications Application[]
  automations  EmailAutomation[]

  @@index([organizationId, position])
}

// ───────────────────────── Candidates & resumes ─────────────────────────

enum CandidateSource {
  UPLOAD
  CAREER_PORTAL
  REFERRAL
  AGENCY
  LINKEDIN
  JOB_BOARD
  OTHER
}

enum ConsentStatus {
  UNKNOWN
  GRANTED
  WITHDRAWN
}

model Candidate {
  id                   String          @id @default(cuid())
  organizationId       String
  fullName             String
  email                String?
  phone                String?
  location             String?
  headline             String?
  summary              String?
  linkedinUrl          String?
  githubUrl            String?
  portfolioUrl         String?
  totalExperienceYears Float?
  skills               String[]
  languages            String[]
  // Structured profile: education, experience, certifications, projects - each item
  // carries `evidence` (verbatim resume snippet) and `confidence` (0-1).
  profile              Json?
  missingFields        String[]
  source               CandidateSource @default(UPLOAD)
  tags                 String[]
  consentStatus        ConsentStatus   @default(UNKNOWN)
  consentUpdatedAt     DateTime?
  createdById          String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resumes        Resume[]
  applications   Application[]
  matches        MatchResult[]
  notes          Note[]
  interviews     Interview[]
  communications Communication[]

  assessments     Assessment[]
  offers          Offer[]
  onboardingTasks OnboardingTask[]

  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, createdAt])
}

enum ResumeStatus {
  UPLOADED
  PROCESSING
  PARSED
  FAILED
}

enum AnalysisMethod {
  AI
  HEURISTIC
}

model UploadBatch {
  id             String   @id @default(cuid())
  organizationId String
  // When set, every parsed candidate is added to this job's pipeline.
  jobId          String?
  total          Int      @default(0)
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  resumes      Resume[]
}

model Resume {
  id                String          @id @default(cuid())
  organizationId    String
  candidateId       String?
  batchId           String?
  fileName          String
  mimeType          String
  sizeBytes         Int
  storageKey        String
  sha256            String
  version           Int             @default(1)
  status            ResumeStatus    @default(UPLOADED)
  rawText           String?
  parsed            Json?
  parseMethod       AnalysisMethod?
  model             String?
  promptVersion     String?
  overallConfidence Float?
  error             String?
  uploadedById      String?
  createdAt         DateTime        @default(now())
  processedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate    Candidate?   @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  batch        UploadBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([organizationId, sha256])
  @@index([candidateId])
  @@index([batchId])
}

// ───────────────────────── Applications & matching ─────────────────────────

enum ApplicationStatus {
  ACTIVE
  REJECTED
  HIRED
  WITHDRAWN
}

model Application {
  id              String            @id @default(cuid())
  organizationId  String
  jobId           String
  candidateId     String
  stageId         String
  status          ApplicationStatus @default(ACTIVE)
  rejectionReason String?
  rejectedAt      DateTime?
  hiredAt         DateTime?
  isReapplication Boolean           @default(false)
  source          CandidateSource   @default(UPLOAD)
  /// Written by the candidate on the public careers portal; never edited by staff.
  coverLetter     String?
  stageEnteredAt  DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job            Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate      Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage          PipelineStage   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  matches        MatchResult[]
  notes          Note[]
  interviews     Interview[]
  communications Communication[]

  assessments Assessment[]
  offers      Offer[]

  @@unique([jobId, candidateId])
  @@index([organizationId, stageId])
  @@index([organizationId, status])
}

enum ReviewStatus {
  PENDING
  ACCEPTED
  ADJUSTED
  DISMISSED
}

// Matching history: a new row per run. AI output is advisory; humans review it.
model MatchResult {
  id               String         @id @default(cuid())
  organizationId   String
  applicationId    String
  jobId            String
  candidateId      String
  score            Int
  breakdown        Json
  matchedSkills    String[]
  missingSkills    String[]
  strengths        Json
  gaps             Json
  summary          String
  confidence       Float
  method           AnalysisMethod
  model            String?
  promptVersion    String
  criteriaSnapshot Json
  blindMode        Boolean        @default(true)
  reviewStatus     ReviewStatus   @default(PENDING)
  adjustedScore    Int?
  reviewNote       String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application  Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([organizationId, jobId])
}

// ───────────────────────── Collaboration & audit ─────────────────────────

model Note {
  id             String   @id @default(cuid())
  organizationId String
  candidateId    String
  applicationId  String?
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application  Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt])
}

// Activity timeline + audit log in one append-only table.
model Activity {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String
  candidateId    String?
  jobId          String?
  applicationId  String?
  data           Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([candidateId, createdAt])
  @@index([jobId, createdAt])
}

// ───────────────────────── Platform ─────────────────────────

enum BackgroundJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// Postgres-backed work queue (FOR UPDATE SKIP LOCKED). Swap for BullMQ/Redis at scale.
model BackgroundJob {
  id             String              @id @default(cuid())
  organizationId String?
  type           String
  payload        Json
  status         BackgroundJobStatus @default(PENDING)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  runAt          DateTime            @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  idempotencyKey String?             @unique
  createdAt      DateTime            @default(now())
  completedAt    DateTime?

  @@index([status, runAt])
}

model AiUsage {
  id             String   @id @default(cuid())
  organizationId String
  feature        String
  model          String
  inputTokens    Int
  outputTokens   Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ═══════════════════════ Phase 2: Interviews ═══════════════════════

enum QuestionCategory {
  TECHNICAL
  BEHAVIORAL
  SITUATIONAL
  HR
  ROLE_SPECIFIC
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

/// Reusable question bank. AI-generated questions land here as drafts for human curation.
model InterviewQuestion {
  id             String             @id @default(cuid())
  organizationId String
  text           String
  category       QuestionCategory
  difficulty     QuestionDifficulty @default(MEDIUM)
  skills         String[]
  /// What a good answer covers - shown to interviewers, never to candidates.
  guidance       String?
  /// Why this question was suggested for a candidate (e.g. a resume claim to probe).
  rationale      String?
  jobId          String?
  source         AnalysisMethod     @default(HEURISTIC)
  model          String?
  promptVersion  String?
  approved       Boolean            @default(false)
  archivedAt     DateTime?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?                    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  usages       InterviewQuestionItem[]

  @@index([organizationId, category])
  @@index([organizationId, jobId])
}

enum InterviewKind {
  SCREENING
  TECHNICAL
  BEHAVIORAL
  PANEL
  HR
  FINAL
}

/// Named interview format: duration, question set and the scorecard criteria to rate against.
model InterviewTemplate {
  id              String        @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  jobId           String?
  kind            InterviewKind @default(TECHNICAL)
  durationMinutes Int           @default(60)
  /// ScorecardCriterion[] - see scorecard-criteria.ts. Weights must total 100.
  criteria        Json
  questionIds     String[]
  isDefault       Boolean       @default(false)
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  interviews   Interview[]

  @@unique([organizationId, name])
  @@index([organizationId, jobId])
}

enum InterviewMode {
  VIDEO
  PHONE
  ONSITE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Interview {
  id                String          @id @default(cuid())
  organizationId    String
  applicationId     String
  jobId             String
  candidateId       String
  templateId        String?
  title             String
  kind              InterviewKind   @default(TECHNICAL)
  round             Int             @default(1)
  mode              InterviewMode   @default(VIDEO)
  /// Stored in UTC; `timezone` is the IANA zone the organizer scheduled in.
  startsAt          DateTime
  endsAt            DateTime
  timezone          String
  location          String?
  meetingLink       String?
  agenda            String?
  status            InterviewStatus @default(SCHEDULED)
  /// Set when this interview replaced an earlier one, so the history stays intact.
  rescheduledFromId String?         @unique
  cancelReason      String?
  cancelledAt       DateTime?
  completedAt       DateTime?
  /// Snapshot of the template's criteria, so later template edits don't rewrite history.
  criteria          Json
  createdById       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application     Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  job             Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate       Candidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  template        InterviewTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  rescheduledFrom Interview?              @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Interview?              @relation("Reschedule")
  participants    InterviewParticipant[]
  questions       InterviewQuestionItem[]
  scorecards      Scorecard[]
  communications  Communication[]

  @@index([organizationId, startsAt])
  @@index([applicationId, round])
  @@index([candidateId])
}

enum ParticipantRole {
  LEAD
  PANEL
  OBSERVER
}

enum ParticipantResponse {
  PENDING
  ACCEPTED
  DECLINED
}

model InterviewParticipant {
  id          String              @id @default(cuid())
  interviewId String
  userId      String
  role        ParticipantRole     @default(PANEL)
  response    ParticipantResponse @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime            @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@index([userId])
}

/// Questions attached to one interview. Text is copied so later bank edits don't alter the record.
model InterviewQuestionItem {
  id          String             @id @default(cuid())
  interviewId String
  questionId  String?
  text        String
  category    QuestionCategory
  difficulty  QuestionDifficulty
  guidance    String?
  rationale   String?
  position    Int

  interview Interview          @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question  InterviewQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([interviewId, position])
}

enum Recommendation {
  STRONG_YES
  YES
  LEAN_YES
  LEAN_NO
  NO
  STRONG_NO
}

/// One interviewer's structured feedback. Ratings are human input; AI never writes a scorecard.
model Scorecard {
  id             String          @id @default(cuid())
  organizationId String
  interviewId    String
  interviewerId  String
  /// { [criterionId]: { rating: 1-5, comment?: string } }
  ratings        Json
  overallRating  Float?
  recommendation Recommendation?
  strengths      String?
  concerns       String?
  notes          String?
  /// AI-written recap of this interviewer's own notes. Advisory, clearly labelled.
  aiSummary      String?
  aiModel        String?
  submittedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  interview    Interview    @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer  User         @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  @@unique([interviewId, interviewerId])
  @@index([organizationId, submittedAt])
}

/// Recurring weekly availability per interviewer, in the organization's timezone.
model InterviewerAvailability {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /// 0 = Sunday through 6 = Saturday
  weekday        Int
  startMinute    Int
  endMinute      Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
}

// ═══════════════════════ Phase 2: Communications ═══════════════════════

enum TemplateKey {
  APPLICATION_RECEIVED
  SHORTLISTED
  INTERVIEW_INVITATION
  INTERVIEW_REMINDER
  INTERVIEW_RESCHEDULED
  INTERVIEW_CANCELLED
  ASSESSMENT_INVITATION
  SELECTED
  REJECTED
  OFFER
  CUSTOM
}

model EmailTemplate {
  id             String      @id @default(cuid())
  organizationId String
  key            TemplateKey
  name           String
  subject        String
  body           String
  enabled        Boolean     @default(true)
  isDefault      Boolean     @default(false)
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automations    EmailAutomation[]
  communications Communication[]

  @@index([organizationId, key])
}

enum AutomationTrigger {
  APPLICATION_CREATED
  STAGE_CHANGED
  INTERVIEW_SCHEDULED
  INTERVIEW_RESCHEDULED
  INTERVIEW_CANCELLED
  INTERVIEW_REMINDER
  APPLICATION_REJECTED
  CANDIDATE_HIRED
}

/// Fires a template when something happens. Off by default; a human turns each one on.
model EmailAutomation {
  id             String            @id @default(cuid())
  organizationId String
  trigger        AutomationTrigger
  /// Only for STAGE_CHANGED: which stage entry fires this.
  stageId        String?
  templateId     String
  enabled        Boolean           @default(false)
  /// Lead time in hours for INTERVIEW_REMINDER.
  offsetHours    Int               @default(24)
  updatedById    String?
  updatedAt      DateTime          @updatedAt
  createdAt      DateTime          @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     EmailTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stage        PipelineStage? @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([organizationId, trigger, stageId])
}

enum CommunicationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

/// Every message the platform sends, with its outcome. Append-only history.
model Communication {
  id             String              @id @default(cuid())
  organizationId String
  candidateId    String?
  applicationId  String?
  interviewId    String?
  templateId     String?
  templateKey    TemplateKey?
  trigger        AutomationTrigger?
  toEmail        String
  subject        String
  body           String
  status         CommunicationStatus @default(QUEUED)
  error          String?
  /// Set when a send was deliberately not made (e.g. no email on file).
  skipReason     String?
  sentAt         DateTime?
  /// Null when an automation sent it rather than a person.
  sentById       String?
  automated      Boolean             @default(false)
  createdAt      DateTime            @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate    Candidate?     @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  application  Application?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  interview    Interview?     @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  template     EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  assessmentId String?
  offerId      String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  offer        Offer?      @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([candidateId, createdAt])
  @@index([applicationId])
}

// ═══════════════════════ Phase 3: Assessments ═══════════════════════

enum AssessmentQuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  SHORT_ANSWER
  LONG_ANSWER
  NUMERIC
}

enum AssessmentKind {
  TECHNICAL
  APTITUDE
  LOGICAL
  DOMAIN
  LANGUAGE
  MIXED
}

/// Question bank for assessments, separate from interview questions.
model AssessmentQuestion {
  id             String                 @id @default(cuid())
  organizationId String
  text           String
  type           AssessmentQuestionType
  kind           AssessmentKind         @default(TECHNICAL)
  difficulty     QuestionDifficulty     @default(MEDIUM)
  /// Choice labels for MCQ types, in display order.
  options        String[]
  /// Indexes into `options` for MCQ, or accepted strings/numbers for the other types.
  correctAnswers String[]
  /// Tolerance for NUMERIC answers (absolute).
  tolerance      Float?
  points         Int                    @default(1)
  /// Shown to the candidate after submission when the organization allows it.
  explanation    String?
  skills         String[]
  jobId          String?
  source         AnalysisMethod         @default(HEURISTIC)
  model          String?
  promptVersion  String?
  approved       Boolean                @default(false)
  archivedAt     DateTime?
  createdById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  answers      AssessmentAnswer[]
  items        AssessmentItem[]

  @@index([organizationId, kind])
  @@index([organizationId, jobId])
}

/// A reusable paper: which questions, how long, what counts as a pass.
model AssessmentTemplate {
  id                    String         @id @default(cuid())
  organizationId        String
  name                  String
  description           String?
  kind                  AssessmentKind @default(TECHNICAL)
  jobId                 String?
  durationMinutes       Int            @default(45)
  /// Percentage of total points needed to pass. Advisory - a human decides the outcome.
  passingPercent        Int            @default(60)
  /// Randomise question order per candidate, to discourage answer sharing.
  shuffleQuestions      Boolean        @default(true)
  showResultToCandidate Boolean        @default(false)
  isDefault             Boolean        @default(false)
  createdById           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  items        AssessmentItem[]
  assessments  Assessment[]

  @@unique([organizationId, name])
  @@index([organizationId, jobId])
}

/// One question's place on a template.
model AssessmentItem {
  id         String @id @default(cuid())
  templateId String
  questionId String
  position   Int
  /// Overrides the question's own points for this paper.
  points     Int?

  template AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([templateId, questionId])
  @@index([templateId, position])
}

enum AssessmentStatus {
  INVITED
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  EXPIRED
  CANCELLED
}

/// One candidate's sitting of one paper.
model Assessment {
  id                    String           @id @default(cuid())
  organizationId        String
  applicationId         String
  candidateId           String
  jobId                 String
  templateId            String?
  title                 String
  kind                  AssessmentKind
  durationMinutes       Int
  passingPercent        Int
  shuffleQuestions      Boolean          @default(true)
  showResultToCandidate Boolean          @default(false)
  status                AssessmentStatus @default(INVITED)
  /// Hashed single-use link the candidate opens. The plain token is emailed, never stored.
  accessTokenHash       String           @unique
  invitedAt             DateTime         @default(now())
  /// Link stops working after this instant.
  expiresAt             DateTime
  startedAt             DateTime?
  /// Hard deadline once started: startedAt + durationMinutes.
  dueAt                 DateTime?
  submittedAt           DateTime?
  /// Sum of auto-markable points earned.
  autoScore             Int?
  /// Points a human awarded for written answers.
  manualScore           Int?
  totalPoints           Int
  /// autoScore + manualScore once evaluation is complete.
  finalScore            Int?
  percent               Float?
  /// Whether the score cleared passingPercent. Advisory only.
  passed                Boolean?
  evaluatedById         String?
  evaluatedAt           DateTime?
  evaluatorNote         String?
  createdById           String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application    Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate      Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job            Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  template       AssessmentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  answers        AssessmentAnswer[]
  communications Communication[]

  @@index([organizationId, status])
  @@index([applicationId])
  @@index([candidateId])
}

model AssessmentAnswer {
  id               String                 @id @default(cuid())
  assessmentId     String
  questionId       String?
  /// Snapshot of the question as presented, so later bank edits don't rewrite the paper.
  questionText     String
  questionType     AssessmentQuestionType
  options          String[]
  position         Int
  maxPoints        Int
  /// Chosen option indexes for MCQ, or the written/numeric response.
  response         String[]
  /// Null for written answers until a human marks them.
  autoCorrect      Boolean?
  pointsAwarded    Int?
  evaluatorComment String?
  answeredAt       DateTime?

  assessment Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([assessmentId, questionId])
  @@index([assessmentId, position])
}

// ═══════════════════════ Phase 3: Offers & onboarding ═══════════════════════

model OfferTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// Letter body with the same {{placeholders}} as email templates, plus offer fields.
  body           String
  isDefault      Boolean  @default(false)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offers       Offer[]

  @@unique([organizationId, name])
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

model Offer {
  id               String      @id @default(cuid())
  organizationId   String
  applicationId    String
  candidateId      String
  jobId            String
  templateId       String?
  jobTitle         String
  /// Annual or monthly as the organization uses; `salaryPeriod` says which.
  salaryAmount     Int
  salaryCurrency   String
  salaryPeriod     String      @default("MONTHLY")
  /// [{ label, value }] - allowances, bonuses, leave, equipment.
  benefits         Json
  startDate        DateTime
  /// The candidate must respond by this date.
  respondBy        DateTime
  probationMonths  Int?
  noticePeriodDays Int?
  reportingTo      String?
  workLocation     String?
  /// Rendered letter the candidate sees. Frozen when the offer is sent.
  letterBody       String
  status           OfferStatus @default(DRAFT)
  /// Hashed token for the candidate's accept/decline link.
  accessTokenHash  String?     @unique
  sentAt           DateTime?
  respondedAt      DateTime?
  declineReason    String?
  withdrawReason   String?
  createdById      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate       Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job             Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  template        OfferTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  approvals       OfferApproval[]
  onboardingTasks OnboardingTask[]
  communications  Communication[]

  @@index([organizationId, status])
  @@index([applicationId])
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

/// One approver's decision on an offer. Every approver must approve before it can be sent.
model OfferApproval {
  id         String           @id @default(cuid())
  offerId    String
  approverId String
  decision   ApprovalDecision @default(PENDING)
  comment    String?
  decidedAt  DateTime?
  position   Int              @default(0)
  createdAt  DateTime         @default(now())

  offer    Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  approver User  @relation(fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([offerId, approverId])
  @@index([approverId, decision])
}

enum OnboardingCategory {
  DOCUMENT
  IT_SETUP
  HR_ADMIN
  TRAINING
  INTRODUCTION
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

model OnboardingTask {
  id             String             @id @default(cuid())
  organizationId String
  offerId        String
  candidateId    String
  title          String
  description    String?
  category       OnboardingCategory @default(OTHER)
  /// Which team member owns it. Null means unassigned.
  assigneeId     String?
  dueDate        DateTime?
  status         TaskStatus         @default(TODO)
  position       Int
  completedAt    DateTime?
  completedById  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offer        Offer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignee     User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([offerId, position])
  @@index([assigneeId, status])
}
